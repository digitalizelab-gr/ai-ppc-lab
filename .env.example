# Copy this file to .env.local and fill in your own values. .env.local is
# gitignored — never put real secrets in this file.

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Demo gate — set this to require a shared password before the Lab is
# reachable (used when sharing a deployed link with a small group). Leave
# blank/unset to leave the app open, which is also what local dev does by
# default so you're never locked out of your own machine.
PPC_LAB_DEMO_PASSWORD=

# Optional overrides — defaults are gemini-3.6-flash / gemini-3.1-pro-preview.
# (gemini-2.5-flash and gemini-2.5-pro were retired for new API keys and now
# 404 with a migration hint — verified live against the real API.)
# AI_PROVIDER=gemini
# GEMINI_MODEL_FLASH=gemini-3.6-flash
# GEMINI_MODEL_PRO=gemini-3.1-pro-preview
